{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "routes": [
    { "route": "/app", "rewrite": "/app/index.html" },
    { "route": "/help", "rewrite": "/help/index.html" },
    { "route": "/c/*", "rewrite": "/c/index.html" }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/assets/*", "/*.{js,css,mp3,svg,png,ico,webmanifest,json}"]
  },
  "mimeTypes": {
    ".webmanifest": "application/manifest+json"
  }
}
